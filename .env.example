# connector-qa-runner — example environment file.
# Copy to `.env` (next to code/config.py) and fill in real values.
# Never commit a populated `.env`.

# Shared secret for inbound webhook HMAC-SHA256 verification.
HMAC_SECRET=change-me-to-a-long-random-value

# amoCRM (or compatible CRM) downstream credentials.
AMOCRM_BASE_URL=https://your-domain.amocrm.ru
AMOCRM_TOKEN=your-amocrm-long-lived-access-token

# Proactive egress rate limiting (Token Bucket), requests per second / burst.
RATE_LIMIT_RPS=2.0
RATE_LIMIT_BURST=5

# SQLite state database path (WAL mode).
SQLITE_DB_PATH=events.db

# n8n dispatcher webhook used for outbound notifications.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/connector-qa-runner
