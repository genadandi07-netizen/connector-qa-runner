      "id": "ce634356-41ba-5390-bf7d-a044a37bebe4",
      "name": "B2B Gateway: Webhook (POST)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "parameters": {
          "jsCode": "// Verify HMAC-SHA256 signature + timestamp freshness (replay guard).\nconst crypto = require('crypto');\nconst item = $input.first();\nconst h = (item.json.headers || {});\nconst ts = Number(h['x-timestamp'] || h['x-n8n-timestamp'] || 0);\nconst now = Math.floor(Date.now() / 1000);\nif (!ts || Math.abs(now - ts) > 300) throw new Error('timestamp_out_of_window');\nconst raw = item.json.rawBody || JSON.stringify(item.json.body || {});\nconst secret = $env.CRM_WEBHOOK_SECRET || 'CHANGE_ME';\nconst expected = crypto.createHmac('sha256', secret).update(`${ts}.${raw}`).digest('hex');\nconst got = String(h['x-signature'] || '').replace(/^sha256=/, '');\nconst ok = got.length === expected.length &&\n  crypto.timingSafeEqual(Buffer.from(got), Buffer.from(expected));\nif (!ok) throw new Error('invalid_hmac');\nitem.json.verified = true;\nreturn $input.all();"
        }
      },
      "id": "7d3ab049-d1db-5ca8-abc2-1b2d158d7507",
      "name": "Verify HMAC-SHA256 & Timestamp",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "parameters": {
          "jsCode": "// SQLite WAL dedup with BEGIN IMMEDIATE to take a write lock atomically.\nconst Database = require('better-sqlite3');\nconst db = new Database('/data/gateway.db');\ndb.pragma('journal_mode = WAL');\nconst id = $json.event_id || $json.id;\ndb.exec('BEGIN IMMEDIATE');\nconst row = db.prepare('INSERT OR IGNORE INTO seen(event_id, ts) VALUES (?, ?)')\n  .run(id, Date.now());\ndb.exec('COMMIT');\n$json.duplicate = row.changes === 0;\nreturn $input.all();"
        }
      },
      "id": "af4a9da2-c728-5b6b-a18e-8c3c70d8d35e",
      "name": "SQLite WAL BEGIN IMMEDIATE Dedup",
