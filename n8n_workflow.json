        "parameters": {
          "jsCode": "// Atomic DLQ fallback: persist the failed envelope for later replay.\nconst Database = require('better-sqlite3');\nconst db = new Database('/data/gateway.db');\ndb.pragma('journal_mode = WAL');\ndb.prepare('INSERT INTO dlq(payload, error, ts) VALUES (?, ?, ?)')\n  .run(JSON.stringify($json), JSON.stringify($json.error || null), Date.now());\nreturn $input.all();"
        }
